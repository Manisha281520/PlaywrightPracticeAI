{
  "name": "playwright-practice-ai",
  "version": "1.0.0",
  "description": "Playwright practice framework with auth, fixtures, POM and API testing",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test tests/login.spec.js",
    "test:api": "npx playwright test tests/api.spec.js",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "dotenv": "^16.0.0"
  }
}
